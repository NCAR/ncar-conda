#!/bin/bash
#PBS -N npl-tests
#PBS -A SCSG0001
#PBS -l walltime=01:30:00
#PBS -j oe
#
#   Run the NPL test suite on one node type for a control env and a candidate env,
#   then compare them. Queue/select come from the qsub command line, e.g.:
#
#     T=/glade/work/$USER/nplplan/ncar-conda/tests
#     qsub -q casper -l select=2:ncpus=4:mpiprocs=4:mem=32GB -l place=scatter \
#          -v TESTS=$T,CONTROL=<prefix>,CANDIDATE=<prefix>,LABEL=casper-cpu \
#          -o /glade/derecho/scratch/$USER/npl-scratch/tests/ $T/jobs/node_test.pbs
#
#   Optional -v: PYTEST_ARGS (e.g. "-m 'smoke or mpi'", "--run-pbs --account=X")
#                CANDIDATE_SPEC=<environment.yml> when the candidate was created from a full lock
#   Results: /glade/derecho/scratch/$USER/npl-scratch/tests/<LABEL>/<jobid>/
#            {<env>/junit.xml, <env>/fingerprint.json, SUMMARY.md}
#   Default login modules are deliberately left loaded (realistic user session).

set -uo pipefail
TESTS=${TESTS:?set TESTS to the tests/ directory}
CONTROL=${CONTROL:?set CONTROL to the release env prefix}
CANDIDATE=${CANDIDATE:?set CANDIDATE to the candidate env prefix}
LABEL=${LABEL:-$(hostname -s)}
OUT=/glade/derecho/scratch/$USER/npl-scratch/tests/$LABEL/${PBS_JOBID%%.*}
mkdir -p "$OUT"

rc=0
for prefix in "$CONTROL" "$CANDIDATE"; do
    name=$(basename "$prefix")
    echo "=== $(date +%T) $name"
    spec=""                              # lock-built candidate: test its month's environment.yml
    [[ $prefix == "$CANDIDATE" && -n ${CANDIDATE_SPEC:-} ]] && spec=$CANDIDATE_SPEC
    eval "NPL_SPEC=\"$spec\" $TESTS/harness/run.sh \"$prefix\" \"$OUT/$name\" ${PYTEST_ARGS:-}" > "$OUT/$name.console" 2>&1
    r=$?
    echo "    pytest exit $r"
    (( r != 0 && r != 1 )) && rc=2      # harness/usage problem, not test failures
    (( r == 1 && rc == 0 )) && rc=1
done

py=$(readlink -f "$CANDIDATE")/bin/python
{
    echo "# NPL tests on $LABEL (job ${PBS_JOBID:-n/a}, $(date +%F))"
    echo
    "$py" -I "$TESTS/harness/report.py" compare "$OUT/$(basename "$CONTROL")" "$OUT/$(basename "$CANDIDATE")"
    echo
    for prefix in "$CONTROL" "$CANDIDATE"; do
        "$py" -I "$TESTS/harness/report.py" summary "$OUT/$(basename "$prefix")"
        echo
    done
} > "$OUT/SUMMARY.md" 2>&1
cat "$OUT/SUMMARY.md"
echo "Results: $OUT"
exit $rc
